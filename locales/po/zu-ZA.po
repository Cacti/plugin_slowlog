msgstr "Ifomethi Yefayela Embi - Akukho Okufakiwe Kwilogi Yemibuzo Ehamba Kancane Okutholakele"

#: includes/functions.php
msgid "The initial Slowlog has been ingested.  Post Processing will take place in the background.  You can start analyzing the Details once the status is complete"
msgstr "I-Slowlog yokuqala isifakiwe. Ukucubungula Kwakamuva kuzokwenzeka ngemuva. Ungaqala ukuhlaziya Imininingwane uma isimo sesiqediwe"

#: includes/functions.php
msgid "Post Processing Failed - Database Error"
msgstr "Ukucubungula Kwakamuva Kuhlulekile - Iphutha Lesizindalwazi"

#: includes/functions.php
#, php-format
msgid "max_execution_time is %d seconds (not unlimited) for this request - a large import could be killed mid-run. Some web servers/proxies (Apache Timeout, Nginx fastcgi_read_timeout/proxy_read_timeout, PHP-FPM request_terminate_timeout) enforce their own independent cutoff that this setting cannot override."
msgstr "I-max_execution_time iyimizuzwana engu-%d (ayikhululekile emkhawulweni) kulesi sicelo - ukungenisa okukhulu kungase kunqanyulwe maphakathi nokusebenza. Amanye amaseva ewebhu noma ama-proxy (Apache Timeout, Nginx fastcgi_read_timeout/proxy_read_timeout, PHP-FPM request_terminate_timeout) asebenzisa umkhawulo wawo ozimele lesi silungiselelo esingenakuwushaya indiva."

#: includes/functions.php
#, php-format
msgid "memory_limit is %s (not unlimited) for this request - a very large slow query log can exceed this while it is being read/imported."
msgstr "I-memory_limit ingu-%s (ayikhululekile emkhawulweni) kulesi sicelo - ilogi enkulu kakhulu yemibuzo ehamba kancane ingeqa lo mkhawulo ngenkathi ifundwa noma ingeniswa."

#: includes/functions.php
#, php-format
msgid "post_max_size (%s) is smaller than upload_max_filesize (%s) - uploads up to the advertised limit will still be rejected."
msgstr "I-post_max_size (%s) incane kune-upload_max_filesize (%s) - okulayishwayo okufika emkhawulweni omenyezelwe kusazokwenqatshwa."

#: includes/functions.php
#, php-format
msgid "upload_max_filesize (%s) is small for a MySQL/MariaDB slow query log, which can easily be hundreds of MB."
msgstr "I-upload_max_filesize (%s) incane kakhulu kwilogi yemibuzo ehamba kancane ye-MySQL/MariaDB, engafinyelela kalula emakhulwini ama-MB."

#: includes/functions.php
msgid "ERROR: The uploaded Slowlog file exceeds the server's maximum upload filesize."
msgstr "IPHUTHA: Ifayela le-Slowlog elilayishiwe leqa usayizi omkhulu wokulayisha weserva."

#: includes/functions.php
msgid "ERROR: The Slowlog file upload was interrupted before it finished - please try again."
msgstr "IPHUTHA: Ukulayishwa kwefayela le-Slowlog kuphazamisekile ngaphambi kokuba kuqede - sicela uzame futhi."

#: includes/functions.php
msgid "ERROR: The server has no temporary folder configured to receive the uploaded Slowlog file."
msgstr "IPHUTHA: Iseva ayinayo ifolda yesikhashana elungiselelwe ukwamukela ifayela le-Slowlog elilayishiwe."

#: includes/functions.php
msgid "ERROR: The server failed to write the uploaded Slowlog file to disk."
msgstr "IPHUTHA: Iseva ihlulekile ukubhala ifayela le-Slowlog elilayishiwe kudiski."

#: includes/functions.php
msgid "ERROR: A server extension blocked the Slowlog file upload."
msgstr "IPHUTHA: Isandiso seserva sivimbe ukulayishwa kwefayela le-Slowlog."

#: includes/functions.php
#, php-format
msgid "ERROR: The Slowlog file upload failed (error code %d)."
msgstr "IPHUTHA: Ukulayishwa kwefayela le-Slowlog kuhlulekile (ikhodi yephutha %d)."

