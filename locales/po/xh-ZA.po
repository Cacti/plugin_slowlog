msgstr "Ifomati Yefayile Embi - Akukho Mangeno eLogi yeMibuzo Ecothayo Afunyenweyo"

#: includes/functions.php
msgid "The initial Slowlog has been ingested.  Post Processing will take place in the background.  You can start analyzing the Details once the status is complete"
msgstr "I-Slowlog yokuqala ifakiwe. Ukulungiswa kwangemva kuya kuqhubeka ngasemva. Ungaqala ukuhlalutya Iinkcukacha nje ukuba imeko igqitywe"

#: includes/functions.php
msgid "Post Processing Failed - Database Error"
msgstr "Ukulungiswa Kwangemva Akuphumelelanga - Impazamo yeDathabheyisi"

#: includes/functions.php
#, php-format
msgid "max_execution_time is %d seconds (not unlimited) for this request - a large import could be killed mid-run. Some web servers/proxies (Apache Timeout, Nginx fastcgi_read_timeout/proxy_read_timeout, PHP-FPM request_terminate_timeout) enforce their own independent cutoff that this setting cannot override."
msgstr "I-max_execution_time yimizuzwana eyi-%d (ayikho kwindawo engenamda) kwesi sicelo - ungeniso olukhulu lunokumiswa phakathi ekusebenzeni. Ezinye iiseva zewebhu/iiproksi (Apache Timeout, Nginx fastcgi_read_timeout/proxy_read_timeout, PHP-FPM request_terminate_timeout) zisebenzisa umda wazo ozimeleyo ongenakutshintshwa yile setingi."

#: includes/functions.php
#, php-format
msgid "memory_limit is %s (not unlimited) for this request - a very large slow query log can exceed this while it is being read/imported."
msgstr "I-memory_limit yi-%s (ayikho kwindawo engenamda) kwesi sicelo - ilogi yemibuzo ecothayo enkulu kakhulu ingagqitha kulo mda xa ifundwa/ingeniswa."

#: includes/functions.php
#, php-format
msgid "post_max_size (%s) is smaller than upload_max_filesize (%s) - uploads up to the advertised limit will still be rejected."
msgstr "I-post_max_size (%s) incinci kune-upload_max_filesize (%s) - ukulayisha okuya kumda obhengezweyo kuya kuhlala kwaliwa."

#: includes/functions.php
#, php-format
msgid "upload_max_filesize (%s) is small for a MySQL/MariaDB slow query log, which can easily be hundreds of MB."
msgstr "I-upload_max_filesize (%s) incinci kakhulu kwilogi yemibuzo ecothayo ye-MySQL/MariaDB, enokuba ngamakhulu ee-MB lula."

#: includes/functions.php
msgid "ERROR: The uploaded Slowlog file exceeds the server's maximum upload filesize."
msgstr "IMPAZAMO: Ifayile ye-Slowlog elayishiweyo igqitha ubungakanani obukhulu bokulayisha befayile beseva."

#: includes/functions.php
msgid "ERROR: The Slowlog file upload was interrupted before it finished - please try again."
msgstr "IMPAZAMO: Ukulayishwa kwefayile ye-Slowlog kuphazanyisiwe phambi kokuba kugqitywe - nceda uzame kwakhona."

#: includes/functions.php
msgid "ERROR: The server has no temporary folder configured to receive the uploaded Slowlog file."
msgstr "IMPAZAMO: Iseva ayinayo ifolda yethutyana eqwalaselwe ukwamkela ifayile ye-Slowlog elayishiweyo."

#: includes/functions.php
msgid "ERROR: The server failed to write the uploaded Slowlog file to disk."
msgstr "IMPAZAMO: Iseva isilele ukubhala ifayile ye-Slowlog elayishiweyo kwidiski."

#: includes/functions.php
msgid "ERROR: A server extension blocked the Slowlog file upload."
msgstr "IMPAZAMO: Isandiso seseva sithintele ukulayishwa kwefayile ye-Slowlog."

#: includes/functions.php
#, php-format
msgid "ERROR: The Slowlog file upload failed (error code %d)."
msgstr "IMPAZAMO: Ukulayishwa kwefayile ye-Slowlog akuphumelelanga (ikhowudi yempazamo %d)."

