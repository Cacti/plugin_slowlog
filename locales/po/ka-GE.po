#: import_log.php
#, php-format
msgid "ERROR: Invalid --logid value '%s', must be a positive integer"
msgstr "შეცდომა: არასწორი --logid მნიშვნელობა '%s', უნდა იყოს დადებითი მთელი რიცხვი"

#: includes/functions.php
msgid "ERROR: Unable to remove the imported Slowlog file."
msgstr "შეცდომა: იმპორტირებული Slowlog ფაილის წაშლა ვერ მოხერხდა."

#: includes/functions.php
msgid "Import Failed - Row Insert Error"
msgstr "იმპორტი ვერ მოხერხდა - მწკრივის ჩასმის შეცდომა"

#: slowlog.php
msgid "ERROR: You do not have permission to import or delete Slowlog files."
msgstr "შეცდომა: თქვენ არ გაქვთ Slowlog ფაილების იმპორტის ან წაშლის უფლება."

#: includes/functions.php
msgid "Read Error - Import Aborted, Log May Be Truncated"
msgstr "წაკითხვის შეცდომა - იმპორტი შეწყდა, ჟურნალი შესაძლოა მოკვეთილი იყოს"

#: includes/functions.php
msgid "Import Failed - Database Error"
msgstr "იმპორტი ვერ მოხერხდა - მონაცემთა ბაზის შეცდომა"

#: includes/functions.php
msgid "Import Failed - Unable to Open File"
msgstr "იმპორტი ვერ მოხერხდა - ფაილის გახსნა ვერ მოხერხდა"

#: includes/functions.php
msgid "Import Failed - Unable to Create Parent Record"
msgstr "იმპორტი ვერ მოხერხდა - მშობელი ჩანაწერის შექმნა ვერ მოხერხდა"

#: includes/functions.php
msgid "Bad File Format - No Slow Query Log Entries Found"
msgstr "ფაილის არასწორი ფორმატი - ნელი მოთხოვნების ჟურნალის ჩანაწერები ვერ მოიძებნა"

#: includes/functions.php
msgid "The initial Slowlog has been ingested.  Post Processing will take place in the background.  You can start analyzing the Details once the status is complete"
msgstr "საწყისი Slowlog ჩატვირთულია. შემდგომი დამუშავება ფონურ რეჟიმში განხორციელდება. დეტალების ანალიზის დაწყებას შეძლებთ სტატუსის დასრულების შემდეგ"

#: includes/functions.php
msgid "Post Processing Failed - Database Error"
msgstr "შემდგომი დამუშავება ვერ მოხერხდა - მონაცემთა ბაზის შეცდომა"

#: includes/functions.php
#, php-format
msgid "max_execution_time is %d seconds (not unlimited) for this request - a large import could be killed mid-run. Some web servers/proxies (Apache Timeout, Nginx fastcgi_read_timeout/proxy_read_timeout, PHP-FPM request_terminate_timeout) enforce their own independent cutoff that this setting cannot override."
msgstr "ამ მოთხოვნისთვის max_execution_time არის %d წამი (არა ულიმიტო) - დიდი იმპორტი შესაძლოა შუა პროცესში შეწყდეს. ზოგიერთი ვებსერვერი/პროქსი (Apache Timeout, Nginx fastcgi_read_timeout/proxy_read_timeout, PHP-FPM request_terminate_timeout) იყენებს საკუთარ დამოუკიდებელ ლიმიტს, რომელსაც ეს პარამეტრი ვერ გადაფარავს."

#: includes/functions.php
#, php-format
msgid "memory_limit is %s (not unlimited) for this request - a very large slow query log can exceed this while it is being read/imported."
msgstr "ამ მოთხოვნისთვის memory_limit არის %s (არა ულიმიტო) - ძალიან დიდმა ნელი მოთხოვნების ჟურნალმა შესაძლოა წაკითხვის/იმპორტის დროს გადააჭარბოს ამ ლიმიტს."

#: includes/functions.php
#, php-format
msgid "post_max_size (%s) is smaller than upload_max_filesize (%s) - uploads up to the advertised limit will still be rejected."
msgstr "post_max_size (%s) ნაკლებია upload_max_filesize-ზე (%s) - გამოცხადებულ ლიმიტამდე ატვირთვები მაინც უარყოფილი იქნება."

#: includes/functions.php
#, php-format
msgid "upload_max_filesize (%s) is small for a MySQL/MariaDB slow query log, which can easily be hundreds of MB."
msgstr "upload_max_filesize (%s) მცირეა MySQL/MariaDB ნელი მოთხოვნების ჟურნალისთვის, რომლის ზომაც ადვილად შეიძლება ასობით მბ იყოს."

#: includes/functions.php
msgid "ERROR: The uploaded Slowlog file exceeds the server's maximum upload filesize."
msgstr "შეცდომა: ატვირთული Slowlog ფაილი აღემატება სერვერის ატვირთვის მაქსიმალურ ზომას."

#: includes/functions.php
msgid "ERROR: The Slowlog file upload was interrupted before it finished - please try again."
msgstr "შეცდომა: Slowlog ფაილის ატვირთვა დასრულებამდე შეწყდა - გთხოვთ, სცადოთ ხელახლა."

#: includes/functions.php
msgid "ERROR: The server has no temporary folder configured to receive the uploaded Slowlog file."
msgstr "შეცდომა: სერვერზე არ არის კონფიგურირებული დროებითი საქაღალდე ატვირთული Slowlog ფაილის მისაღებად."

#: includes/functions.php
msgid "ERROR: The server failed to write the uploaded Slowlog file to disk."
msgstr "შეცდომა: სერვერმა ვერ ჩაწერა ატვირთული Slowlog ფაილი დისკზე."

#: includes/functions.php
msgid "ERROR: A server extension blocked the Slowlog file upload."
msgstr "შეცდომა: სერვერის გაფართოებამ დაბლოკა Slowlog ფაილის ატვირთვა."

#: includes/functions.php
#, php-format
msgid "ERROR: The Slowlog file upload failed (error code %d)."
msgstr "შეცდომა: Slowlog ფაილის ატვირთვა ვერ მოხერხდა (შეცდომის კოდი %d)."

