msgstr "არა"

#: slowlog.php
msgid "Return"
msgstr "დაბრუნება"

#: slowlog.php
msgid "Import Template from Local File"
msgstr "შაბლონის იმპორტი ლოკალური ფაილიდან"

#: slowlog.php
msgid "If the XML file containing template data is located on your local machine, select it here."
msgstr "თუ შაბლონის მონაცემების შემცველი XML ფაილი თქვენს ლოკალურ კომპიუტერზეა, აირჩიეთ იგი აქ."

#: slowlog.php
msgid "LogFile Description"
msgstr "ჟურნალის ფაილის აღწერა"

#: slowlog.php
msgid "Please provide a description for this MySQL Slowlog file to be imported."
msgstr "გთხოვთ, მიუთითოთ აღწერა იმპორტირებადი MySQL Slowlog ფაილისთვის."

#: slowlog.php
msgid "New Slow Log"
msgstr "ახალი Slow Log"

#: slowlog.php
msgid "Max Query Length"
msgstr "მოთხოვნის მაქს. სიგრძე"

#: slowlog.php
msgid "Only import the first X characters of the SQL Query from the MySQL Slow Query log."
msgstr "MySQL ნელი მოთხოვნების ჟურნალიდან SQL მოთხოვნის მხოლოდ პირველი X სიმბოლოს იმპორტი."

#: slowlog.php
msgid "All"
msgstr "ყველა"

#: slowlog.php
#, php-format
msgid "%d Chars"
msgstr "%d სიმბოლო"

#: slowlog.php
msgid "Slowlog Table Names [ optional ]"
msgstr "Slowlog ცხრილების სახელები [ არასავალდებულო ]"

#: slowlog.php
msgid "Leave Blank for Auto Detection which runs must faster."
msgstr "დატოვეთ ცარიელი ავტომატური აღმოჩენისთვის, რომელიც გაცილებით სწრაფად მუშაობს."

#: slowlog.php
msgid "Cacti Table Detection"
msgstr "Cacti ცხრილების აღმოჩენა"

#: slowlog.php
msgid "How to tell Cacti-native tables apart from other tables referenced in the slow query log. Defaults to detecting every table with no grouping."
msgstr "როგორ განასხვავოს Cacti-ის საკუთარი ცხრილები ნელი მოთხოვნების ჟურნალში მოხსენიებული სხვა ცხრილებისგან. ნაგულისხმევად აღმოაჩენს ყველა ცხრილს დაჯგუფების გარეშე."

#: slowlog.php
msgid "Detect all tables (no 'OTHER TABLES' grouping)"
msgstr "ყველა ცხრილის აღმოჩენა ('OTHER TABLES' დაჯგუფების გარეშე)"

#: slowlog.php
msgid "Use this Cacti Database; group other tables as 'OTHER TABLES'"
msgstr "ამ Cacti მონაცემთა ბაზის გამოყენება; სხვა ცხრილების დაჯგუფება როგორც 'OTHER TABLES'"

#: slowlog.php
msgid "Detect all tables; group tables not in the list below as 'OTHER TABLES'"
msgstr "ყველა ცხრილის აღმოჩენა; ქვემოთ მოცემულ სიაში არარსებული ცხრილების დაჯგუფება როგორც 'OTHER TABLES'"

#: slowlog.php
msgid "Tables of Interest"
msgstr "საინტერესო ცხრილები"

#: slowlog.php
msgid "Only used by the 'Detect all tables; group ... as OTHER TABLES' option above. Please provide a space delimited list of known tables to compare against. In Linux/UNIX, you may obtain a list of tables by using the following command:<br><br> print `mysql -u<i><b>user</b></i> -p<i><b>password</b></i> -e \"show tables\" <i><b>database</b></i> | grep -v Tables_in` | tr '\\n' ' '<br><br>The values of '<i><b>user</b></i>', '<i><b>password</b></i>', and '<i><b>database</b></i>' are replaced with your values."
msgstr "გამოიყენება მხოლოდ ზემოთ მოცემული 'ყველა ცხრილის აღმოჩენა; ... OTHER TABLES' პარამეტრის მიერ. გთხოვთ, მიუთითოთ შესადარებელი ცნობილი ცხრილების სია გამოტოვებით გამოყოფილი. Linux/UNIX-ში ცხრილების სიის მიღება შეგიძლიათ შემდეგი ბრძანებით:<br><br> print `mysql -u<i><b>user</b></i> -p<i><b>password</b></i> -e \"show tables\" <i><b>database</b></i> | grep -v Tables_in` | tr '\\n' ' '<br><br>'<i><b>user</b></i>', '<i><b>password</b></i>' და '<i><b>database</b></i>' მნიშვნელობები ჩაანაცვლეთ თქვენი მონაცემებით."

#: slowlog.php
msgid "Upload Limits"
msgstr "ატვირთვის ლიმიტები"

#: slowlog.php
msgid "File Size upload limits in Cacti."
msgstr "ფაილის ზომის ატვირთვის ლიმიტები Cacti-ში."

#: slowlog.php
msgid "Max Upload Filesize"
msgstr "ატვირთვის ფაილის მაქს. ზომა"

#: slowlog.php
msgid "The maximum filesize your Apache server will allow to be uploaded is set to the value on the right.  Currently, you can not upload a file larger than this.  If you have MySQL Slow logs larger than this, you must alter the <i>php.ini</i> file associated with Apache, find the variable <b><i>upload_max_filesize</i></b> and increase the value.  After which you must restart Apache."
msgstr "მაქსიმალური ფაილის ზომა, რომლის ატვირთვასაც თქვენი Apache სერვერი უშვებს, მითითებულია მარჯვნივ. ამჟამად ამაზე დიდი ფაილის ატვირთვა შეუძლებელია. თუ გაქვთ ამაზე დიდი MySQL Slow ჟურნალები, უნდა შეცვალოთ Apache-თან დაკავშირებული <i>php.ini</i> ფაილი, იპოვოთ ცვლადი <b><i>upload_max_filesize</i></b> და გაზარდოთ მისი მნიშვნელობა. ამის შემდეგ უნდა გადატვირთოთ Apache."

#: slowlog.php
msgid "Max Post Size"
msgstr "POST-ის მაქს. ზომა"

#: slowlog.php
msgid "The maximum size you can post to the Apache server is set to the value on the right.  If you have MySQL Slow logs larger than this value, you must alter the <i>php.ini</i> file associated with Apache, find the variable <b><i>post_max_size</i></b> and increase its value.  After which you must restart Apache."
msgstr "მაქსიმალური ზომა, რომლის გაგზავნაც შეგიძლიათ Apache სერვერზე, მითითებულია მარჯვნივ. თუ გაქვთ ამ მნიშვნელობაზე დიდი MySQL Slow ჟურნალები, უნდა შეცვალოთ Apache-თან დაკავშირებული <i>php.ini</i> ფაილი, იპოვოთ ცვლადი <b><i>post_max_size</i></b> და გაზარდოთ მისი მნიშვნელობა. ამის შემდეგ უნდა გადატვირთოთ Apache."

#: slowlog.php
msgid "Max Execution Time"
msgstr "შესრულების მაქს. დრო"

#: slowlog.php
msgid "How long (in seconds) this request is allowed to run for; 0 means unlimited. This plugin already raises it to unlimited for its own requests, but a web server or reverse proxy in front of PHP (Apache Timeout, Nginx fastcgi_read_timeout/proxy_read_timeout, PHP-FPM request_terminate_timeout) can still cut the request off independently - that cannot be detected or overridden from here."
msgstr "რამდენ ხანს (წამებში) აქვს ამ მოთხოვნას გაშვების უფლება; 0 ნიშნავს ულიმიტოს. ეს პლაგინი უკვე ზრდის მას ულიმიტომდე საკუთარი მოთხოვნებისთვის, მაგრამ PHP-ის წინ მდგომმა ვებსერვერმა ან უკუპროქსიმ (Apache Timeout, Nginx fastcgi_read_timeout/proxy_read_timeout, PHP-FPM request_terminate_timeout) მაინც შეიძლება დამოუკიდებლად შეწყვიტოს მოთხოვნა - ამის აღმოჩენა ან გადაფარვა აქედან შეუძლებელია."

#: slowlog.php
msgid "Unlimited"
msgstr "ულიმიტო"

#: slowlog.php
msgid "Memory Limit"
msgstr "მეხსიერების ლიმიტი"

#: slowlog.php
