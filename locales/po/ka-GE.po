msgstr "შეცდომა: პარამეტრი 'ყველა ცხრილის აღმოჩენა; ... OTHER TABLES ჯგუფში გაერთიანება' მოითხოვს საინტერესო ცხრილების სიას."

#: slowlog.php
msgid "ERROR: Unable to stage the uploaded Slowlog file for import."
msgstr "შეცდომა: ატვირთული Slowlog ფაილის იმპორტისთვის მომზადება ვერ მოხერხდა."

#: slowlog.php
msgid "ERROR: Unable to create the Slowlog import record."
msgstr "შეცდომა: Slowlog იმპორტის ჩანაწერის შექმნა ვერ მოხერხდა."

#: slowlog.php
msgid "The Slowlog has been queued and will be imported in the background. Refresh this page to track progress."
msgstr "Slowlog დაემატა რიგში და ფონურ რეჟიმში იმპორტირდება. პროგრესის სანახავად განაახლეთ ეს გვერდი."

#: slowlog.php
msgid "You must select at least one Slowlog record."
msgstr "თქვენ უნდა აირჩიოთ მინიმუმ ერთი Slowlog ჩანაწერი."

#: slowlog.php
msgid "Yes"
msgstr "დიახ"

#: slowlog.php
