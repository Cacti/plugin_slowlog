msgstr "GREŠKA: Nemate dozvolu za uvoz ili brisanje Slowlog datoteka."

#: includes/functions.php
msgid "Read Error - Import Aborted, Log May Be Truncated"
msgstr "Greška pri čitanju - Uvoz prekinut, dnevnik je možda skraćen"

#: includes/functions.php
msgid "Import Failed - Database Error"
msgstr "Uvoz nije uspio - Greška baze podataka"

#: includes/functions.php
msgid "Import Failed - Unable to Open File"
msgstr "Uvoz nije uspio - Nije moguće otvoriti datoteku"

#: includes/functions.php
msgid "Import Failed - Unable to Create Parent Record"
msgstr "Uvoz nije uspio - Nije moguće kreirati nadređeni zapis"

#: includes/functions.php
msgid "Bad File Format - No Slow Query Log Entries Found"
msgstr "Loš format datoteke - Nisu pronađeni unosi dnevnika sporih upita"

#: includes/functions.php
msgid "The initial Slowlog has been ingested.  Post Processing will take place in the background.  You can start analyzing the Details once the status is complete"
msgstr "Početni Slowlog je učitan. Naknadna obrada će se odvijati u pozadini. Možete početi analizirati detalje kada status bude završen"

#: includes/functions.php
msgid "Post Processing Failed - Database Error"
msgstr "Naknadna obrada nije uspjela - Greška baze podataka"

#: includes/functions.php
#, php-format
msgid "max_execution_time is %d seconds (not unlimited) for this request - a large import could be killed mid-run. Some web servers/proxies (Apache Timeout, Nginx fastcgi_read_timeout/proxy_read_timeout, PHP-FPM request_terminate_timeout) enforce their own independent cutoff that this setting cannot override."
msgstr "max_execution_time je %d sekundi (nije neograničeno) za ovaj zahtjev - veliki uvoz bi mogao biti prekinut usred izvođenja. Neki web serveri/proksiji (Apache Timeout, Nginx fastcgi_read_timeout/proxy_read_timeout, PHP-FPM request_terminate_timeout) primjenjuju vlastito nezavisno ograničenje koje ova postavka ne može nadjačati."

#: includes/functions.php
#, php-format
msgid "memory_limit is %s (not unlimited) for this request - a very large slow query log can exceed this while it is being read/imported."
msgstr "memory_limit je %s (nije neograničeno) za ovaj zahtjev - veoma veliki dnevnik sporih upita može premašiti ovo ograničenje tokom čitanja/uvoza."

#: includes/functions.php
#, php-format
msgid "post_max_size (%s) is smaller than upload_max_filesize (%s) - uploads up to the advertised limit will still be rejected."
msgstr "post_max_size (%s) je manji od upload_max_filesize (%s) - otpremanja do oglašenog ograničenja će i dalje biti odbijena."

#: includes/functions.php
#, php-format
msgid "upload_max_filesize (%s) is small for a MySQL/MariaDB slow query log, which can easily be hundreds of MB."
msgstr "upload_max_filesize (%s) je premali za MySQL/MariaDB dnevnik sporih upita, koji lako može imati stotine MB."

#: includes/functions.php
msgid "ERROR: The uploaded Slowlog file exceeds the server's maximum upload filesize."
msgstr "GREŠKA: Otpremljena Slowlog datoteka premašuje maksimalnu veličinu datoteke za otpremanje na serveru."

#: includes/functions.php
msgid "ERROR: The Slowlog file upload was interrupted before it finished - please try again."
msgstr "GREŠKA: Otpremanje Slowlog datoteke je prekinuto prije završetka - pokušajte ponovo."

#: includes/functions.php
msgid "ERROR: The server has no temporary folder configured to receive the uploaded Slowlog file."
msgstr "GREŠKA: Server nema konfigurisan privremeni direktorij za primanje otpremljene Slowlog datoteke."

#: includes/functions.php
msgid "ERROR: The server failed to write the uploaded Slowlog file to disk."
msgstr "GREŠKA: Server nije uspio zapisati otpremljenu Slowlog datoteku na disk."

#: includes/functions.php
msgid "ERROR: A server extension blocked the Slowlog file upload."
msgstr "GREŠKA: Serversko proširenje je blokiralo otpremanje Slowlog datoteke."

#: includes/functions.php
#, php-format
msgid "ERROR: The Slowlog file upload failed (error code %d)."
msgstr "GREŠKA: Otpremanje Slowlog datoteke nije uspjelo (kod greške %d)."

