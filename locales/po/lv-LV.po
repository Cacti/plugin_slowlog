msgid "ERROR: Unable to remove the imported Slowlog file."
msgstr "KĻŪDA: Nevar noņemt importēto Slowlog failu."

#: includes/functions.php
msgid "Import Failed - Row Insert Error"
msgstr "Importēšana neizdevās - rindas ievietošanas kļūda"

#: slowlog.php
