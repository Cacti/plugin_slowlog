msgid "Import Failed - Database Error"
msgstr "Importēšana neizdevās - datubāzes kļūda"

#: includes/functions.php
msgid "Import Failed - Unable to Open File"
msgstr "Importēšana neizdevās - nevar atvērt failu"

#: includes/functions.php
msgid "Import Failed - Unable to Create Parent Record"
msgstr "Importēšana neizdevās - nevar izveidot vecākierakstu"

#: includes/functions.php
msgid "Bad File Format - No Slow Query Log Entries Found"
msgstr "Nederīgs faila formāts - netika atrasti lēno vaicājumu žurnāla ieraksti"

#: includes/functions.php
msgid "The initial Slowlog has been ingested.  Post Processing will take place in the background.  You can start analyzing the Details once the status is complete"
msgstr "Sākotnējais Slowlog žurnāls ir ielādēts. Pēcapstrāde notiks fonā. Varat sākt detalizēto datu analīzi, tiklīdz statuss būs pabeigts"

#: includes/functions.php
msgid "Post Processing Failed - Database Error"
msgstr "Pēcapstrāde neizdevās - datubāzes kļūda"

#: includes/functions.php
#, php-format
msgid "max_execution_time is %d seconds (not unlimited) for this request - a large import could be killed mid-run. Some web servers/proxies (Apache Timeout, Nginx fastcgi_read_timeout/proxy_read_timeout, PHP-FPM request_terminate_timeout) enforce their own independent cutoff that this setting cannot override."
msgstr "max_execution_time šim pieprasījumam ir %d sekundes (nav neierobežots) - liela importa izpilde var tikt pārtraukta pusceļā. Daži tīmekļa serveri/starpniekserveri (Apache Timeout, Nginx fastcgi_read_timeout/proxy_read_timeout, PHP-FPM request_terminate_timeout) piemēro savu neatkarīgu laika ierobežojumu, ko šis iestatījums nevar pārrakstīt."

#: includes/functions.php
#, php-format
msgid "memory_limit is %s (not unlimited) for this request - a very large slow query log can exceed this while it is being read/imported."
msgstr "memory_limit šim pieprasījumam ir %s (nav neierobežots) - ļoti liels lēno vaicājumu žurnāls lasīšanas/importēšanas laikā var pārsniegt šo ierobežojumu."

#: includes/functions.php
#, php-format
msgid "post_max_size (%s) is smaller than upload_max_filesize (%s) - uploads up to the advertised limit will still be rejected."
msgstr "post_max_size (%s) ir mazāks par upload_max_filesize (%s) - augšupielādes līdz norādītajam ierobežojumam tik un tā tiks noraidītas."

#: includes/functions.php
#, php-format
msgid "upload_max_filesize (%s) is small for a MySQL/MariaDB slow query log, which can easily be hundreds of MB."
msgstr "upload_max_filesize (%s) ir mazs MySQL/MariaDB lēno vaicājumu žurnālam, kura izmērs viegli var sasniegt simtiem MB."

#: includes/functions.php
msgid "ERROR: The uploaded Slowlog file exceeds the server's maximum upload filesize."
msgstr "KĻŪDA: Augšupielādētais Slowlog fails pārsniedz servera maksimālo augšupielādes faila izmēru."

#: includes/functions.php
msgid "ERROR: The Slowlog file upload was interrupted before it finished - please try again."
msgstr "KĻŪDA: Slowlog faila augšupielāde tika pārtraukta pirms pabeigšanas - lūdzu, mēģiniet vēlreiz."

#: includes/functions.php
msgid "ERROR: The server has no temporary folder configured to receive the uploaded Slowlog file."
msgstr "KĻŪDA: Serverī nav konfigurēta pagaidu mape augšupielādētā Slowlog faila saņemšanai."

#: includes/functions.php
msgid "ERROR: The server failed to write the uploaded Slowlog file to disk."
msgstr "KĻŪDA: Serverim neizdevās saglabāt augšupielādēto Slowlog failu diskā."

#: includes/functions.php
msgid "ERROR: A server extension blocked the Slowlog file upload."
msgstr "KĻŪDA: Servera paplašinājums bloķēja Slowlog faila augšupielādi."

#: includes/functions.php
#, php-format
msgid "ERROR: The Slowlog file upload failed (error code %d)."
msgstr "KĻŪDA: Slowlog faila augšupielāde neizdevās (kļūdas kods %d)."

