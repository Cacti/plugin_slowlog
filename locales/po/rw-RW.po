msgid "Post Processing Failed - Database Error"
msgstr "Itunganya rya Nyuma Ryanze - Ikosa ry'Ububikoshingiro"

#: includes/functions.php
#, php-format
msgid "max_execution_time is %d seconds (not unlimited) for this request - a large import could be killed mid-run. Some web servers/proxies (Apache Timeout, Nginx fastcgi_read_timeout/proxy_read_timeout, PHP-FPM request_terminate_timeout) enforce their own independent cutoff that this setting cannot override."
msgstr "max_execution_time ni amasegonda %d (ifite umupaka) kuri iki gisabwa - kwinjiza dosiye nini bishobora guhagarikwa bitararangira. Zimwe muri seriveri z'urubuga/proxy (Apache Timeout, Nginx fastcgi_read_timeout/proxy_read_timeout, PHP-FPM request_terminate_timeout) zishyiraho umupaka wazo wigenga iri genamiterere ridashobora guhindura."

#: includes/functions.php
#, php-format
msgid "memory_limit is %s (not unlimited) for this request - a very large slow query log can exceed this while it is being read/imported."
msgstr "memory_limit ni %s (ifite umupaka) kuri iki gisabwa - inyandiko nini cyane y'amabaza atinda ishobora kurenza uyu mupaka mu gihe isomwa cyangwa yinjizwa."

#: includes/functions.php
#, php-format
msgid "post_max_size (%s) is smaller than upload_max_filesize (%s) - uploads up to the advertised limit will still be rejected."
msgstr "post_max_size (%s) ni ntoya kuri upload_max_filesize (%s) - amadosiye yoherejwe agera ku mupaka utangajwe azakomeza kwangwa."

#: includes/functions.php
#, php-format
msgid "upload_max_filesize (%s) is small for a MySQL/MariaDB slow query log, which can easily be hundreds of MB."
msgstr "upload_max_filesize (%s) ni ntoya ku nyandiko y'amabaza atinda ya MySQL/MariaDB, ishobora kugera mu majana ya MB bitagoranye."

#: includes/functions.php
msgid "ERROR: The uploaded Slowlog file exceeds the server's maximum upload filesize."
msgstr "IKOSA: Dosiye ya Slowlog yoherejwe irarenze ingano ntarengwa ya seriveri yo kohereza dosiye."

#: includes/functions.php
msgid "ERROR: The Slowlog file upload was interrupted before it finished - please try again."
