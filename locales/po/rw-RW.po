#: includes/functions.php
msgid "ERROR: The server has no temporary folder configured to receive the uploaded Slowlog file."
msgstr "IKOSA: Seriveri nta bubiko bw'agateganyo yageneye kwakira dosiye ya Slowlog yoherejwe."

#: includes/functions.php
msgid "ERROR: The server failed to write the uploaded Slowlog file to disk."
msgstr "IKOSA: Seriveri yananiwe kwandika dosiye ya Slowlog yoherejwe ku bubiko."

#: includes/functions.php
msgid "ERROR: A server extension blocked the Slowlog file upload."
msgstr "IKOSA: Umugereka wa seriveri wahagaritse kohereza dosiye ya Slowlog."

#: includes/functions.php
#, php-format
msgid "ERROR: The Slowlog file upload failed (error code %d)."
msgstr "IKOSA: Kohereza dosiye ya Slowlog byanze (kode y'ikosa %d)."

