#: includes/functions.php
#, php-format
msgid "max_execution_time is %d seconds (not unlimited) for this request - a large import could be killed mid-run. Some web servers/proxies (Apache Timeout, Nginx fastcgi_read_timeout/proxy_read_timeout, PHP-FPM request_terminate_timeout) enforce their own independent cutoff that this setting cannot override."
msgstr "max_execution_time bụ sekọnd %d (ọ bụghị enweghị oke) maka arịrịọ a - a pụrụ igbu nnukwu mbubata n'etiti ọrụ. Ụfọdụ sava weebụ/prọksị (Apache Timeout, Nginx fastcgi_read_timeout/proxy_read_timeout, PHP-FPM request_terminate_timeout) na-amanye oke oge nke ha nke ntọala a na-enweghị ike imeri."

#: includes/functions.php
#, php-format
msgid "memory_limit is %s (not unlimited) for this request - a very large slow query log can exceed this while it is being read/imported."
msgstr "memory_limit bụ %s (ọ bụghị enweghị oke) maka arịrịọ a - nnukwu ndekọ ajụjụ nwayọọ nwere ike ịkarị nke a ka a na-agụ/ebubata ya."

#: includes/functions.php
#, php-format
msgid "post_max_size (%s) is smaller than upload_max_filesize (%s) - uploads up to the advertised limit will still be rejected."
msgstr "post_max_size (%s) dị ntakịrị karịa upload_max_filesize (%s) - a ka ga-ajụ mbunye ruo oke ekwupụtara."

#: includes/functions.php
#, php-format
msgid "upload_max_filesize (%s) is small for a MySQL/MariaDB slow query log, which can easily be hundreds of MB."
msgstr "upload_max_filesize (%s) dị ntakịrị maka ndekọ ajụjụ nwayọọ MySQL/MariaDB, nke nwere ike ịdị ọtụtụ narị MB ngwa ngwa."

