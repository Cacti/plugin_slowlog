msgstr "Ingiza tu herufi X za kwanza za Hoja ya SQL kutoka kwenye kumbukumbu ya Hoja za Polepole ya MySQL."

#: slowlog.php
msgid "All"
msgstr "Zote"

#: slowlog.php
