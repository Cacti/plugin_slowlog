#: includes/functions.php
msgid "The initial Slowlog has been ingested.  Post Processing will take place in the background.  You can start analyzing the Details once the status is complete"
msgstr "Slowlog ya awali imepokelewa. Uchakataji wa Baadaye utafanyika chinichini. Unaweza kuanza kuchanganua Maelezo mara tu hali itakapokamilika"

#: includes/functions.php
msgid "Post Processing Failed - Database Error"
msgstr "Uchakataji wa Baadaye Umeshindwa - Hitilafu ya Hifadhidata"

#: includes/functions.php
#, php-format
msgid "max_execution_time is %d seconds (not unlimited) for this request - a large import could be killed mid-run. Some web servers/proxies (Apache Timeout, Nginx fastcgi_read_timeout/proxy_read_timeout, PHP-FPM request_terminate_timeout) enforce their own independent cutoff that this setting cannot override."
msgstr "max_execution_time ni sekunde %d (si bila kikomo) kwa ombi hili - uingizaji mkubwa unaweza kusitishwa katikati. Baadhi ya seva za wavuti/proksi (Apache Timeout, Nginx fastcgi_read_timeout/proxy_read_timeout, PHP-FPM request_terminate_timeout) hutekeleza kikomo chao huru ambacho mpangilio huu hauwezi kukibatilisha."

#: includes/functions.php
#, php-format
msgid "memory_limit is %s (not unlimited) for this request - a very large slow query log can exceed this while it is being read/imported."
msgstr "memory_limit ni %s (si bila kikomo) kwa ombi hili - kumbukumbu kubwa sana ya hoja za polepole inaweza kuzidi kiwango hiki wakati inasomwa/inaingizwa."

#: includes/functions.php
#, php-format
msgid "post_max_size (%s) is smaller than upload_max_filesize (%s) - uploads up to the advertised limit will still be rejected."
msgstr "post_max_size (%s) ni ndogo kuliko upload_max_filesize (%s) - upakiaji hadi kikomo kilichotangazwa bado utakataliwa."

#: includes/functions.php
#, php-format
msgid "upload_max_filesize (%s) is small for a MySQL/MariaDB slow query log, which can easily be hundreds of MB."
msgstr "upload_max_filesize (%s) ni ndogo kwa kumbukumbu ya hoja za polepole ya MySQL/MariaDB, ambayo inaweza kufikia mamia ya MB kwa urahisi."

#: includes/functions.php
msgid "ERROR: The uploaded Slowlog file exceeds the server's maximum upload filesize."
msgstr "HITILAFU: Faili ya Slowlog iliyopakiwa inazidi ukubwa wa juu zaidi wa kupakia wa seva."

#: includes/functions.php
msgid "ERROR: The Slowlog file upload was interrupted before it finished - please try again."
msgstr "HITILAFU: Upakiaji wa faili ya Slowlog ulikatizwa kabla ya kukamilika - tafadhali jaribu tena."

#: includes/functions.php
msgid "ERROR: The server has no temporary folder configured to receive the uploaded Slowlog file."
msgstr "HITILAFU: Seva haina folda ya muda iliyosanidiwa kupokea faili ya Slowlog iliyopakiwa."

#: includes/functions.php
msgid "ERROR: The server failed to write the uploaded Slowlog file to disk."
msgstr "HITILAFU: Seva ilishindwa kuandika faili ya Slowlog iliyopakiwa kwenye diski."

#: includes/functions.php
msgid "ERROR: A server extension blocked the Slowlog file upload."
msgstr "HITILAFU: Kiendelezi cha seva kilizuia upakiaji wa faili ya Slowlog."

#: includes/functions.php
#, php-format
msgid "ERROR: The Slowlog file upload failed (error code %d)."
msgstr "HITILAFU: Upakiaji wa faili ya Slowlog umeshindwa (msimbo wa hitilafu %d)."

