#: import_log.php
#, php-format
msgid "ERROR: Invalid --logid value '%s', must be a positive integer"
msgstr "ПОМИЛКА: неприпустиме значення --logid '%s', має бути додатним цілим числом"

#: includes/functions.php
msgid "ERROR: Unable to remove the imported Slowlog file."
msgstr "ПОМИЛКА: не вдалося видалити імпортований файл журналу повільних запитів."

#: includes/functions.php
msgid "Import Failed - Row Insert Error"
msgstr "Помилка імпорту — помилка вставлення рядка"

#: slowlog.php
msgid "ERROR: You do not have permission to import or delete Slowlog files."
msgstr "ПОМИЛКА: у вас немає прав на імпорт або видалення файлів журналу повільних запитів."

#: includes/functions.php
msgid "Read Error - Import Aborted, Log May Be Truncated"
msgstr "Помилка читання — імпорт перервано, журнал може бути обрізаним"

#: includes/functions.php
msgid "Import Failed - Database Error"
msgstr "Помилка імпорту — помилка бази даних"

#: includes/functions.php
msgid "Import Failed - Unable to Open File"
msgstr "Помилка імпорту — не вдалося відкрити файл"

#: includes/functions.php
msgid "Import Failed - Unable to Create Parent Record"
msgstr "Помилка імпорту — не вдалося створити батьківський запис"

#: includes/functions.php
msgid "Bad File Format - No Slow Query Log Entries Found"
msgstr "Неприпустимий формат файлу — записів журналу повільних запитів не знайдено"

#: includes/functions.php
msgid "The initial Slowlog has been ingested.  Post Processing will take place in the background.  You can start analyzing the Details once the status is complete"
msgstr "Початковий журнал повільних запитів завантажено. Постобробка відбуватиметься у фоновому режимі. Ви зможете розпочати аналіз подробиць після завершення обробки"

#: includes/functions.php
msgid "Post Processing Failed - Database Error"
msgstr "Помилка постобробки — помилка бази даних"

#: includes/functions.php
#, php-format
msgid "max_execution_time is %d seconds (not unlimited) for this request - a large import could be killed mid-run. Some web servers/proxies (Apache Timeout, Nginx fastcgi_read_timeout/proxy_read_timeout, PHP-FPM request_terminate_timeout) enforce their own independent cutoff that this setting cannot override."
msgstr "Параметр max_execution_time для цього запиту становить %d с (не необмежено) — великий імпорт може бути перервано під час виконання. Деякі вебсервери або проксі (Apache Timeout, Nginx fastcgi_read_timeout/proxy_read_timeout, PHP-FPM request_terminate_timeout) мають власні незалежні обмеження часу, які це налаштування не може перевизначити."

#: includes/functions.php
#, php-format
msgid "memory_limit is %s (not unlimited) for this request - a very large slow query log can exceed this while it is being read/imported."
msgstr "Параметр memory_limit для цього запиту становить %s (не необмежено) — дуже великий журнал повільних запитів може перевищити цей ліміт під час читання/імпорту."

#: includes/functions.php
#, php-format
msgid "post_max_size (%s) is smaller than upload_max_filesize (%s) - uploads up to the advertised limit will still be rejected."
msgstr "Значення post_max_size (%s) менше за upload_max_filesize (%s) — завантаження до заявленого обмеження все одно буде відхилено."

#: includes/functions.php
#, php-format
msgid "upload_max_filesize (%s) is small for a MySQL/MariaDB slow query log, which can easily be hundreds of MB."
msgstr "Значення upload_max_filesize (%s) замале для журналу повільних запитів MySQL/MariaDB, який легко може сягати сотень МБ."

#: includes/functions.php
msgid "ERROR: The uploaded Slowlog file exceeds the server's maximum upload filesize."
msgstr "ПОМИЛКА: завантажений файл журналу повільних запитів перевищує максимальний розмір завантаження сервера."

#: includes/functions.php
msgid "ERROR: The Slowlog file upload was interrupted before it finished - please try again."
msgstr "ПОМИЛКА: завантаження файлу журналу повільних запитів перервалося до завершення — спробуйте ще раз."

#: includes/functions.php
msgid "ERROR: The server has no temporary folder configured to receive the uploaded Slowlog file."
msgstr "ПОМИЛКА: на сервері не налаштовано тимчасовий каталог для прийому завантаженого файлу журналу повільних запитів."

#: includes/functions.php
msgid "ERROR: The server failed to write the uploaded Slowlog file to disk."
msgstr "ПОМИЛКА: серверу не вдалося записати завантажений файл журналу повільних запитів на диск."

#: includes/functions.php
msgid "ERROR: A server extension blocked the Slowlog file upload."
msgstr "ПОМИЛКА: розширення сервера заблокувало завантаження файлу журналу повільних запитів."

#: includes/functions.php
#, php-format
msgid "ERROR: The Slowlog file upload failed (error code %d)."
msgstr "ПОМИЛКА: не вдалося завантажити файл журналу повільних запитів (код помилки %d)."

