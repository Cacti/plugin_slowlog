msgstr "As die XML-lêer wat sjabloondata bevat op jou plaaslike masjien geleë is, kies dit hier."

#: slowlog.php
msgid "LogFile Description"
msgstr "Loglêerbeskrywing"

#: slowlog.php
msgid "Please provide a description for this MySQL Slowlog file to be imported."
msgstr "Verskaf asseblief 'n beskrywing vir hierdie MySQL Slowlog-lêer wat ingevoer gaan word."

#: slowlog.php
msgid "New Slow Log"
msgstr "Nuwe stadige logboek"

#: slowlog.php
msgid "Max Query Length"
msgstr "Maks. navraaglengte"

#: slowlog.php
msgid "Only import the first X characters of the SQL Query from the MySQL Slow Query log."
msgstr "Voer slegs die eerste X karakters van die SQL-navraag uit die MySQL stadige navraag-logboek in."

