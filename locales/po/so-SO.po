msgid "Post Processing Failed - Database Error"
msgstr "Hawl-qabadkii Dambe Wuu Fashilmay - Khalad Kaydka Xogta"

#: includes/functions.php
#, php-format
msgid "max_execution_time is %d seconds (not unlimited) for this request - a large import could be killed mid-run. Some web servers/proxies (Apache Timeout, Nginx fastcgi_read_timeout/proxy_read_timeout, PHP-FPM request_terminate_timeout) enforce their own independent cutoff that this setting cannot override."
msgstr "max_execution_time waa %d ilbiriqsi (ma aha mid aan xad lahayn) codsigan - soo dhoofin weyn waxaa la joojin karaa iyadoo dhexda mareysa. Qaar ka mid ah adeegayaasha webka/wakiillada (Apache Timeout, Nginx fastcgi_read_timeout/proxy_read_timeout, PHP-FPM request_terminate_timeout) waxay leeyihiin xad u gaar ah oo aan dejintani dhaafi karin."

#: includes/functions.php
#, php-format
msgid "memory_limit is %s (not unlimited) for this request - a very large slow query log can exceed this while it is being read/imported."
msgstr "memory_limit waa %s (ma aha mid aan xad lahayn) codsigan - diiwaanka weydiimaha gaabiska ah ee aadka u weyn wuu dhaafi karaa xadkan inta la akhrinayo/la soo dhoofinayo."

#: includes/functions.php
#, php-format
msgid "post_max_size (%s) is smaller than upload_max_filesize (%s) - uploads up to the advertised limit will still be rejected."
msgstr "post_max_size (%s) wuu ka yar yahay upload_max_filesize (%s) - faylasha la soo geliyo ee gaaraya xadka la sheegay weli waa la diidi doonaa."

#: includes/functions.php
#, php-format
msgid "upload_max_filesize (%s) is small for a MySQL/MariaDB slow query log, which can easily be hundreds of MB."
msgstr "upload_max_filesize (%s) wuu ku yar yahay diiwaanka weydiimaha gaabiska ah ee MySQL/MariaDB, kaas oo si fudud u gaari kara boqollaal MB."

#: includes/functions.php
msgid "ERROR: The uploaded Slowlog file exceeds the server's maximum upload filesize."
msgstr "KHALAD: Faylka Slowlog ee la soo geliyay wuu ka weyn yahay cabbirka ugu badan ee adeeguhu ogol yahay in la soo geliyo."

#: includes/functions.php
msgid "ERROR: The Slowlog file upload was interrupted before it finished - please try again."
msgstr "KHALAD: Soo gelinta faylka Slowlog way go'day ka hor intaanay dhammaan - fadlan isku day mar kale."

#: includes/functions.php
msgid "ERROR: The server has no temporary folder configured to receive the uploaded Slowlog file."
