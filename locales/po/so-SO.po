#: includes/functions.php
msgid "ERROR: The server failed to write the uploaded Slowlog file to disk."
msgstr "KHALAD: Adeeguhu wuu ku guuldarreystay inuu faylka Slowlog ee la soo geliyay ku qoro disk-ga."

#: includes/functions.php
msgid "ERROR: A server extension blocked the Slowlog file upload."
msgstr "KHALAD: Kordhin adeegaha ah ayaa xannibtay soo gelinta faylka Slowlog."

