msgstr "Tantara Miadana Vaovao"

#: slowlog.php
msgid "Max Query Length"
msgstr "Halavan'ny Fangatahana Ambony Indrindra"

#: slowlog.php
msgid "Only import the first X characters of the SQL Query from the MySQL Slow Query log."
msgstr "Ny tarehintsoratra X voalohany amin'ny Fangatahana SQL avy amin'ny tantaran'ny fangatahana miadana MySQL ihany no afarana."

#: slowlog.php
msgid "All"
msgstr "Rehetra"

#: slowlog.php
