msgstr "Tsy nahomby ny Fanafarana - Tsy afaka namorona ny firaketana fototra"

#: includes/functions.php
msgid "Bad File Format - No Slow Query Log Entries Found"
msgstr "Endriky ny rakitra tsy mety - Tsy nisy fampidirana tantaran'ny fangatahana miadana hita"

#: includes/functions.php
msgid "The initial Slowlog has been ingested.  Post Processing will take place in the background.  You can start analyzing the Details once the status is complete"
msgstr "Voaray ny Slowlog voalohany.  Hatao any ambadika ny fanodinana aoriana.  Azonao atomboka ny famakafakana ny Antsipiriany rehefa vita ny sata"

#: includes/functions.php
msgid "Post Processing Failed - Database Error"
msgstr "Tsy nahomby ny Fanodinana Aoriana - Hadisoana amin'ny tahiry angona"

#: includes/functions.php
#, php-format
msgid "max_execution_time is %d seconds (not unlimited) for this request - a large import could be killed mid-run. Some web servers/proxies (Apache Timeout, Nginx fastcgi_read_timeout/proxy_read_timeout, PHP-FPM request_terminate_timeout) enforce their own independent cutoff that this setting cannot override."
msgstr "Ny max_execution_time dia %d segondra (tsy hoe tsy voafetra) ho an'ity fangatahana ity - mety ho tapaka eo antenatenany ny fanafarana lehibe. Ny mpizara web/proxy sasany (Apache Timeout, Nginx fastcgi_read_timeout/proxy_read_timeout, PHP-FPM request_terminate_timeout) dia mampihatra fetr'ora mahaleo tena izay tsy vitan'ity fandrindrana ity ny manafoana azy."

#: includes/functions.php
#, php-format
msgid "memory_limit is %s (not unlimited) for this request - a very large slow query log can exceed this while it is being read/imported."
msgstr "Ny memory_limit dia %s (tsy hoe tsy voafetra) ho an'ity fangatahana ity - mety hihoatra an'izany ny rakitra tantaran'ny fangatahana miadana lehibe dia lehibe mandritra ny famakiana/fanafarana azy."

#: includes/functions.php
#, php-format
msgid "post_max_size (%s) is smaller than upload_max_filesize (%s) - uploads up to the advertised limit will still be rejected."
msgstr "Ny post_max_size (%s) dia kely noho ny upload_max_filesize (%s) - mbola holavina ihany ny fampakarana hatramin'ny fetra voalaza."

#: includes/functions.php
#, php-format
msgid "upload_max_filesize (%s) is small for a MySQL/MariaDB slow query log, which can easily be hundreds of MB."
msgstr "Ny upload_max_filesize (%s) dia kely ho an'ny tantaran'ny fangatahana miadana MySQL/MariaDB, izay mora mahatratra an-jatony MB."

#: includes/functions.php
msgid "ERROR: The uploaded Slowlog file exceeds the server's maximum upload filesize."
msgstr "HADISOANA: Mihoatra ny haben'ny rakitra ambony indrindra azo ampiakarina amin'ny mpizara ny rakitra Slowlog nampiakarina."

#: includes/functions.php
msgid "ERROR: The Slowlog file upload was interrupted before it finished - please try again."
msgstr "HADISOANA: Tapaka talohan'ny nahavitany ny fampakarana ny rakitra Slowlog - andramo indray azafady."

#: includes/functions.php
msgid "ERROR: The server has no temporary folder configured to receive the uploaded Slowlog file."
msgstr "HADISOANA: Tsy manana lahatahiry vonjimaika voaomana handraisana ny rakitra Slowlog nampiakarina ny mpizara."

#: includes/functions.php
msgid "ERROR: The server failed to write the uploaded Slowlog file to disk."
msgstr "HADISOANA: Tsy nahavita nanoratra ny rakitra Slowlog nampiakarina tao amin'ny kapila ny mpizara."

#: includes/functions.php
msgid "ERROR: A server extension blocked the Slowlog file upload."
msgstr "HADISOANA: Nisy fanitarana ao amin'ny mpizara nanakana ny fampakarana ny rakitra Slowlog."

#: includes/functions.php
#, php-format
msgid "ERROR: The Slowlog file upload failed (error code %d)."
msgstr "HADISOANA: Tsy nahomby ny fampakarana ny rakitra Slowlog (kaody hadisoana %d)."

