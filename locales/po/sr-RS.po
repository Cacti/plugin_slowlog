#: import_log.php
#, php-format
msgid "ERROR: Invalid --logid value '%s', must be a positive integer"
msgstr "ГРЕШКА: Неисправна вредност --logid '%s', мора бити позитиван цео број"

#: includes/functions.php
msgid "ERROR: Unable to remove the imported Slowlog file."
msgstr "ГРЕШКА: Није могуће уклонити увезену датотеку дневника спорих упита."

#: includes/functions.php
msgid "Import Failed - Row Insert Error"
msgstr "Увоз није успео - грешка при уметању реда"

#: slowlog.php
msgid "ERROR: You do not have permission to import or delete Slowlog files."
msgstr "ГРЕШКА: Немате дозволу за увоз или брисање датотека дневника спорих упита."

#: includes/functions.php
msgid "Read Error - Import Aborted, Log May Be Truncated"
msgstr "Грешка при читању - увоз је прекинут, дневник је можда скраћен"

#: includes/functions.php
msgid "Import Failed - Database Error"
msgstr "Увоз није успео - грешка базе података"

#: includes/functions.php
msgid "Import Failed - Unable to Open File"
msgstr "Увоз није успео - није могуће отворити датотеку"

#: includes/functions.php
msgid "Import Failed - Unable to Create Parent Record"
msgstr "Увоз није успео - није могуће креирати надређени запис"

#: includes/functions.php
msgid "Bad File Format - No Slow Query Log Entries Found"
msgstr "Неисправан формат датотеке - нису пронађене ставке дневника спорих упита"

#: includes/functions.php
msgid "The initial Slowlog has been ingested.  Post Processing will take place in the background.  You can start analyzing the Details once the status is complete"
msgstr "Почетни дневник спорих упита је учитан. Накнадна обрада ће се одвијати у позадини. Можете почети анализу детаља када статус буде завршен"

#: includes/functions.php
msgid "Post Processing Failed - Database Error"
msgstr "Накнадна обрада није успела - грешка базе података"

#: includes/functions.php
#, php-format
msgid "max_execution_time is %d seconds (not unlimited) for this request - a large import could be killed mid-run. Some web servers/proxies (Apache Timeout, Nginx fastcgi_read_timeout/proxy_read_timeout, PHP-FPM request_terminate_timeout) enforce their own independent cutoff that this setting cannot override."
msgstr "max_execution_time износи %d секунди (није неограничено) за овај захтев - велики увоз може бити прекинут усред извршавања. Неки веб-сервери/проксији (Apache Timeout, Nginx fastcgi_read_timeout/proxy_read_timeout, PHP-FPM request_terminate_timeout) примењују сопствено независно ограничење које ово подешавање не може да заобиђе."

#: includes/functions.php
#, php-format
msgid "memory_limit is %s (not unlimited) for this request - a very large slow query log can exceed this while it is being read/imported."
msgstr "memory_limit износи %s (није неограничено) за овај захтев - веома велики дневник спорих упита може премашити ово ограничење током читања/увоза."

#: includes/functions.php
#, php-format
msgid "post_max_size (%s) is smaller than upload_max_filesize (%s) - uploads up to the advertised limit will still be rejected."
msgstr "post_max_size (%s) је мањи од upload_max_filesize (%s) - отпремања до објављеног ограничења ће ипак бити одбијена."

#: includes/functions.php
#, php-format
msgid "upload_max_filesize (%s) is small for a MySQL/MariaDB slow query log, which can easily be hundreds of MB."
msgstr "upload_max_filesize (%s) је мали за MySQL/MariaDB дневник спорих упита, који лако може имати стотине MB."

#: includes/functions.php
msgid "ERROR: The uploaded Slowlog file exceeds the server's maximum upload filesize."
msgstr "ГРЕШКА: Отпремљена датотека дневника спорих упита премашује максималну дозвољену величину отпремања на серверу."

#: includes/functions.php
msgid "ERROR: The Slowlog file upload was interrupted before it finished - please try again."
msgstr "ГРЕШКА: Отпремање датотеке дневника спорих упита је прекинуто пре завршетка - покушајте поново."

#: includes/functions.php
msgid "ERROR: The server has no temporary folder configured to receive the uploaded Slowlog file."
msgstr "ГРЕШКА: На серверу није конфигурисана привремена фасцикла за пријем отпремљене датотеке дневника спорих упита."

#: includes/functions.php
msgid "ERROR: The server failed to write the uploaded Slowlog file to disk."
msgstr "ГРЕШКА: Сервер није успео да упише отпремљену датотеку дневника спорих упита на диск."

#: includes/functions.php
msgid "ERROR: A server extension blocked the Slowlog file upload."
msgstr "ГРЕШКА: Серверско проширење је блокирало отпремање датотеке дневника спорих упита."

#: includes/functions.php
#, php-format
msgid "ERROR: The Slowlog file upload failed (error code %d)."
msgstr "ГРЕШКА: Отпремање датотеке дневника спорих упита није успело (код грешке %d)."

