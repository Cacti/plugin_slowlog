msgid "Bad File Format - No Slow Query Log Entries Found"
msgstr "Neispravan format datoteke - nisu pronađeni unosi zapisnika sporih upita"

#: includes/functions.php
msgid "The initial Slowlog has been ingested.  Post Processing will take place in the background.  You can start analyzing the Details once the status is complete"
msgstr "Početni zapisnik Slowlog je učitan. Naknadna obrada odvijat će se u pozadini. Možete započeti analizu pojedinosti čim status bude dovršen"

#: includes/functions.php
msgid "Post Processing Failed - Database Error"
msgstr "Naknadna obrada nije uspjela - pogreška baze podataka"

#: includes/functions.php
#, php-format
msgid "max_execution_time is %d seconds (not unlimited) for this request - a large import could be killed mid-run. Some web servers/proxies (Apache Timeout, Nginx fastcgi_read_timeout/proxy_read_timeout, PHP-FPM request_terminate_timeout) enforce their own independent cutoff that this setting cannot override."
msgstr "max_execution_time iznosi %d sekundi (nije neograničeno) za ovaj zahtjev - veliki uvoz mogao bi biti prekinut usred izvođenja. Neki web-poslužitelji/proxyji (Apache Timeout, Nginx fastcgi_read_timeout/proxy_read_timeout, PHP-FPM request_terminate_timeout) primjenjuju vlastito neovisno ograničenje koje ova postavka ne može nadjačati."

#: includes/functions.php
#, php-format
msgid "memory_limit is %s (not unlimited) for this request - a very large slow query log can exceed this while it is being read/imported."
msgstr "memory_limit iznosi %s (nije neograničeno) za ovaj zahtjev - vrlo velik zapisnik sporih upita može premašiti ovo ograničenje tijekom čitanja/uvoza."

#: includes/functions.php
#, php-format
msgid "post_max_size (%s) is smaller than upload_max_filesize (%s) - uploads up to the advertised limit will still be rejected."
msgstr "post_max_size (%s) manji je od upload_max_filesize (%s) - prijenosi do oglašenog ograničenja i dalje će biti odbijeni."

#: includes/functions.php
#, php-format
msgid "upload_max_filesize (%s) is small for a MySQL/MariaDB slow query log, which can easily be hundreds of MB."
msgstr "upload_max_filesize (%s) premalen je za zapisnik sporih upita MySQL/MariaDB, koji lako može zauzimati stotine MB."

#: includes/functions.php
msgid "ERROR: The uploaded Slowlog file exceeds the server's maximum upload filesize."
msgstr "POGREŠKA: Prenesena datoteka Slowlog premašuje maksimalnu dopuštenu veličinu prijenosa na poslužitelju."

#: includes/functions.php
msgid "ERROR: The Slowlog file upload was interrupted before it finished - please try again."
msgstr "POGREŠKA: Prijenos datoteke Slowlog prekinut je prije dovršetka - pokušajte ponovno."

#: includes/functions.php
msgid "ERROR: The server has no temporary folder configured to receive the uploaded Slowlog file."
msgstr "POGREŠKA: Poslužitelj nema konfiguriranu privremenu mapu za primanje prenesene datoteke Slowlog."

#: includes/functions.php
msgid "ERROR: The server failed to write the uploaded Slowlog file to disk."
msgstr "POGREŠKA: Poslužitelj nije uspio zapisati prenesenu datoteku Slowlog na disk."

#: includes/functions.php
msgid "ERROR: A server extension blocked the Slowlog file upload."
msgstr "POGREŠKA: Proširenje poslužitelja blokiralo je prijenos datoteke Slowlog."

#: includes/functions.php
#, php-format
msgid "ERROR: The Slowlog file upload failed (error code %d)."
msgstr "POGREŠKA: Prijenos datoteke Slowlog nije uspio (kod pogreške %d)."

